{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://thehippiescientist.net/schemas/research-lane-intake.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","lane","research_only","records"],
  "properties":{
    "schema_version":{"const":1},"lane":{"type":"integer","minimum":1,"maximum":5},"research_only":{"const":true},
    "records":{"type":"array","minItems":1,"maxItems":25,"items":{"type":"object","required":["pmid","title","source_title","abstract","source_url","evidence_class","study_design","study_details","uncertainty","adverse_effects","interactions","limitations","provenance","signals"],"properties":{
      "pmid":{"type":"string","pattern":"^[0-9]{5,10}$"},"title":{"type":"string","minLength":8},"doi":{"type":"string"},"source_title":{"type":"string","minLength":8},"abstract":{"type":"string","minLength":70},"source_url":{"type":"string","format":"uri"},
      "evidence_class":{"enum":["human","animal","in-vitro","mixed","review"]},"study_design":{"type":"string","minLength":2},"study_details":{},"uncertainty":{},"adverse_effects":{},"interactions":{},"limitations":{},"provenance":{},
      "signals":{"type":"object","required":["safety","evidence_gap","contradiction","novelty","graph_connectivity"],"properties":{"safety":{"type":"number","minimum":0,"maximum":1},"evidence_gap":{"type":"number","minimum":0,"maximum":1},"contradiction":{"type":"number","minimum":0,"maximum":1},"novelty":{"type":"number","minimum":0,"maximum":1},"graph_connectivity":{"type":"number","minimum":0,"maximum":1}}}
    }}}
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thehippiescientist.net/schemas/experiment-learning-entry.schema.json",
  "title": "Experiment Learning Ledger Entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment_id","surface","hypothesis","intervention_family","primary_metric","owning_issue","owning_pr","baseline_window","intervention","guardrails","minimum_evidence_requirement","observation_window","result","sample_exposure","attribution_confounds","confidence","decision","rollback_stop_status","meaningful_lesson","retest_after","retest_conditions","observation_sources","revision","supersedes_revision","recorded_at"],
  "properties": {
    "experiment_id":{"type":"string","minLength":1},
    "surface":{"type":"string","minLength":1},
    "hypothesis":{"type":"string","minLength":1},
    "intervention_family":{"type":"string","minLength":1},
    "primary_metric":{"type":"string","minLength":1},
    "owning_issue":{"type":"integer","minimum":1},
    "owning_pr":{"type":["integer","null"],"minimum":1},
    "baseline_window":{"$ref":"#/$defs/window"},
    "intervention":{"type":"string","minLength":1},
    "guardrails":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "minimum_evidence_requirement":{"type":"string","minLength":1},
    "observation_window":{"$ref":"#/$defs/nullableWindow"},
    "result":{"enum":["positive","negative","null","underpowered","invalid","Unknown"]},
    "sample_exposure":{"type":["number","integer","null"],"minimum":0},
    "attribution_confounds":{"type":"array","items":{"type":"string"}},
    "confidence":{"type":"string","minLength":1},
    "decision":{"type":"string","minLength":1},
    "rollback_stop_status":{"type":"string","minLength":1},
    "meaningful_lesson":{"type":"string","minLength":1},
    "retest_after":{"type":["string","null"],"format":"date-time"},
    "retest_conditions":{"type":"array","items":{"type":"string"}},
    "observation_sources":{"type":"array","items":{"type":"string"}},
    "revision":{"type":"integer","minimum":1},
    "supersedes_revision":{"type":["integer","null"],"minimum":1},
    "recorded_at":{"type":"string","format":"date-time"}
  },
  "$defs": {
    "window":{"type":"object","additionalProperties":false,"required":["start","end"],"properties":{"start":{"type":"string","format":"date"},"end":{"type":"string","format":"date"}}},
    "nullableWindow":{"type":"object","additionalProperties":false,"required":["start","end"],"properties":{"start":{"type":["string","null"]},"end":{"type":["string","null"]}}}
  }
}

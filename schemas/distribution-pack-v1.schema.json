{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thehippiescientist.net/schemas/distribution-pack-v1.schema.json",
  "title": "The Hippie Scientist Distribution Pack v1",
  "description": "Downstream rendering contract derived from the existing governed research-distribution objects. This schema is not a scientific source of truth; it carries traceable projections for visual and video production.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packId", "researchObjectIds", "source", "audience", "angle", "claims", "sources", "safety", "uncertainties", "forbiddenExtrapolations", "assetIntents"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "packId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
    "researchObjectIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "contentHash"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://thehippiescientist\\.net/.+/$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "audience": { "type": "string", "minLength": 1, "maxLength": 240 },
    "angle": { "type": "string", "minLength": 1, "maxLength": 240 },
    "claims": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claim" } },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceReference" } },
    "safety": { "type": "array", "items": { "$ref": "#/$defs/boundaryStatement" } },
    "uncertainties": { "type": "array", "items": { "$ref": "#/$defs/boundaryStatement" } },
    "forbiddenExtrapolations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "cta": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["label", "destinationUrl"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "destinationUrl": { "type": "string", "pattern": "^https://thehippiescientist\\.net/.+/$" }
      }
    },
    "assetIntents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "objective", "claimIds"],
        "properties": {
          "type": { "enum": ["infographic", "carousel", "short-video", "social-card", "pinterest"] },
          "objective": { "type": "string", "minLength": 1, "maxLength": 240 },
          "claimIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,79}$" } }
        }
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceStatement", "publicSafeStatement", "strengthDelta", "evidenceContext", "sourceRefs", "consumerInstruction"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,79}$" },
        "sourceStatement": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "publicSafeStatement": { "type": "string", "minLength": 1, "maxLength": 600 },
        "strengthDelta": { "enum": ["none", "weaker"] },
        "evidenceContext": { "enum": ["human", "preclinical", "mixed", "mechanistic", "regulatory", "safety", "editorial"] },
        "sourceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,79}$" } },
        "consumerInstruction": { "const": false },
        "studyContext": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "population": { "type": ["string", "null"], "maxLength": 300 },
            "formulation": { "type": ["string", "null"], "maxLength": 300 },
            "dose": { "type": ["string", "null"], "maxLength": 160 },
            "duration": { "type": ["string", "null"], "maxLength": 160 }
          }
        }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "identifier"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,79}$" },
        "kind": { "enum": ["research-object", "pmid", "doi", "regulatory", "site-citation", "site-evidence-record"] },
        "identifier": { "type": "string", "minLength": 1, "maxLength": 300 },
        "url": { "type": ["string", "null"], "maxLength": 1000 }
      }
    },
    "boundaryStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "sourceRefs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,79}$" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 600 },
        "sourceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,79}$" } }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thehippiescientist.net/schemas/distribution-pack-v1.schema.json",
  "title": "The Hippie Scientist Distribution Pack v1",
  "description": "Deterministic downstream rendering contract derived from exactly one existing governed research-distribution object. V1 permits no free-form factual rewrite or new safety/source assertions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packId", "researchObjectIds", "source", "audience", "angle", "claims", "sources", "provenanceReceipts", "safety", "uncertainties", "forbiddenExtrapolations", "cta", "assetIntents"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "packId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,99}$" },
    "researchObjectIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "contentHash", "findingClaimId", "primarySourceId", "primarySourceUrl"],
      "dependentRequired": {
        "findingClaimId": ["primarySourceId", "primarySourceUrl"],
        "primarySourceId": ["findingClaimId", "primarySourceUrl"],
        "primarySourceUrl": ["findingClaimId", "primarySourceId"],
        "publicationStatus": ["publicationStatusCheckedAt", "publicationStatusAuthorityUrl"],
        "publicationStatusCheckedAt": ["publicationStatus", "publicationStatusAuthorityUrl"],
        "publicationStatusAuthorityUrl": ["publicationStatus", "publicationStatusCheckedAt"]
      },
      "properties": {
        "url": { "type": "string", "pattern": "^https://thehippiescientist\\.net/.+/$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "findingClaimId": { "type": "string", "pattern": "^clm_[a-f0-9]+$" },
        "primarySourceId": { "type": "string", "pattern": "^src_[a-f0-9]+$" },
        "primarySourceUrl": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "publicationStatus": { "enum": ["published", "expression-of-concern", "retracted", "withdrawn"] },
        "publicationStatusCheckedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "publicationStatusAuthorityUrl": { "type": "string", "pattern": "^https://[^\\s]+$" }
      }
    },
    "audience": { "const": "General educational audience" },
    "angle": { "const": "What the evidence actually says" },
    "claims": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/claim" } },
    "sources": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/sourceReference" } },
    "provenanceReceipts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 24,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/provenanceReceipt" }
    },
    "safety": { "type": "array", "minItems": 0, "maxItems": 16, "items": { "$ref": "#/$defs/safetyStatement" } },
    "uncertainties": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/boundaryStatement" } },
    "forbiddenExtrapolations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "destinationUrl"],
      "properties": {
        "label": { "const": "Read the evidence" },
        "destinationUrl": { "type": "string", "pattern": "^https://thehippiescientist\\.net/.+/$" }
      }
    },
    "assetIntents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "objective", "claimIds"],
        "properties": {
          "type": { "enum": ["infographic", "carousel", "short-video", "social-card", "pinterest"] },
          "objective": { "const": "Render the canonical finding without factual rewriting." },
          "claimIds": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "const": "CLAIM_001" } }
        }
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceStatement", "publicSafeStatement", "strengthDelta", "evidenceContext", "evidenceGrade", "sourceRefs", "consumerInstruction", "studyContext"],
      "properties": {
        "id": { "const": "CLAIM_001" },
        "sourceStatement": { "type": "string", "minLength": 1, "maxLength": 800 },
        "publicSafeStatement": { "type": "string", "minLength": 1, "maxLength": 800 },
        "strengthDelta": { "const": "none" },
        "evidenceContext": { "enum": ["human", "preclinical", "mixed"] },
        "evidenceGrade": { "enum": ["A", "B", "C", "D", "Avoid/Insufficient"] },
        "sourceRefs": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "const": "RESEARCH_OBJECT_001" } },
        "consumerInstruction": { "const": false },
        "studyContext": {
          "type": "object",
          "additionalProperties": false,
          "required": ["population", "formulation", "dose", "duration"],
          "properties": {
            "population": { "type": ["string", "null"], "maxLength": 400 },
            "formulation": { "type": ["string", "null"], "maxLength": 400 },
            "dose": { "type": ["string", "null"], "maxLength": 400 },
            "duration": { "type": ["string", "null"], "maxLength": 400 }
          }
        }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "identifier", "url"],
      "properties": {
        "id": { "const": "RESEARCH_OBJECT_001" },
        "kind": { "const": "research-object" },
        "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "url": { "type": "string", "pattern": "^https://thehippiescientist\\.net/.+/$" }
      }
    },
    "provenanceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetPath", "canonicalField", "sourceRef", "fieldHash"],
      "properties": {
        "targetPath": {
          "anyOf": [
            {
              "enum": [
                "$.claims[0].sourceStatement",
                "$.claims[0].publicSafeStatement",
                "$.claims[0].studyContext.population",
                "$.claims[0].studyContext.formulation",
                "$.claims[0].studyContext.dose",
                "$.claims[0].studyContext.duration",
                "$.uncertainties[0].statement"
              ]
            },
            { "type": "string", "pattern": "^\\$\\.safety\\[[0-9]+\\]\\.statement$" }
          ]
        },
        "canonicalField": {
          "anyOf": [
            { "enum": ["finding", "limitation", "populationContext", "formulationContext", "doseContext", "durationContext"] },
            { "type": "string", "pattern": "^safetyWarnings\\[[0-9]+\\]\\.statement$" }
          ]
        },
        "sourceRef": { "const": "RESEARCH_OBJECT_001" },
        "fieldHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "safetyStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canonicalClaimId", "statement", "sourceRefs"],
      "properties": {
        "id": { "type": "string", "pattern": "^SAFETY_[0-9]{3}$" },
        "canonicalClaimId": { "type": "string", "pattern": "^clm_[a-f0-9]+$" },
        "statement": { "type": "string", "minLength": 20, "maxLength": 800 },
        "sourceRefs": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "const": "RESEARCH_OBJECT_001" } }
      }
    },
    "boundaryStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "sourceRefs"],
      "properties": {
        "id": { "const": "UNCERTAINTY_001" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 600 },
        "sourceRefs": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "const": "RESEARCH_OBJECT_001" } }
      }
    }
  }
}

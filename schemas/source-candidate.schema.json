{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hippiescientist.app/schemas/source-candidate.schema.json",
  "title": "Source candidate review queue",
  "description": "Deterministic pre-registry candidate source records linked to governed intake tasks.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "candidateSourceId",
      "intakeTaskId",
      "title",
      "sourceType",
      "sourceClass",
      "evidenceClass",
      "publicationStatus",
      "proposedReliabilityTier",
      "duplicateRisk",
      "reviewStatus",
      "active"
    ],
    "properties": {
      "candidateSourceId": {
        "type": "string",
        "pattern": "^cand_[a-z0-9]+(?:[-_][a-z0-9]+)*$"
      },
      "intakeTaskId": {
        "type": "string",
        "pattern": "^intake_[a-z0-9_]+$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "shortTitle": {
        "type": "string",
        "minLength": 1
      },
      "sourceType": {
        "type": "string",
        "enum": [
          "journal-article",
          "systematic-review",
          "meta-analysis",
          "clinical-trial-registry",
          "monograph",
          "regulatory-guidance",
          "reference-database",
          "book",
          "other"
        ]
      },
      "sourceClass": {
        "type": "string",
        "enum": [
          "randomized-human-trial",
          "non-randomized-human-study",
          "observational-human-evidence",
          "systematic-review-meta-analysis",
          "preclinical-mechanistic-study",
          "traditional-use-monograph",
          "regulatory-agency-monograph-guidance",
          "reference-database-authority"
        ]
      },
      "organization": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "authors": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "publicationYear": {
        "type": "integer",
        "minimum": 1800,
        "maximum": 2100
      },
      "citationText": {
        "type": "string",
        "minLength": 1
      },
      "doi": {
        "type": "string",
        "pattern": "^10\\.[0-9]{4,9}\\/.+"
      },
      "pmid": {
        "type": "string",
        "pattern": "^[1-9][0-9]{4,8}$"
      },
      "canonicalUrl": {
        "type": "string",
        "format": "uri"
      },
      "monographId": {
        "type": "string",
        "minLength": 1
      },
      "isbn": {
        "type": "string",
        "pattern": "^(?:97[89][- ]?)?[0-9][- 0-9]{8,}[0-9Xx]$"
      },
      "language": {
        "type": "string",
        "minLength": 2
      },
      "jurisdiction": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 2
      },
      "evidenceClass": {
        "type": "string",
        "enum": [
          "human-clinical",
          "human-observational",
          "preclinical-mechanistic",
          "traditional-use",
          "regulatory-monograph"
        ]
      },
      "studyDesign": {
        "type": "string",
        "enum": [
          "case-control",
          "case-report",
          "cohort",
          "cross-sectional",
          "database-reference",
          "in-vitro",
          "in-vivo-animal",
          "meta-analysis",
          "narrative-monograph",
          "narrative-review",
          "non-randomized-controlled",
          "non-randomized-trial",
          "other",
          "randomized-controlled-trial",
          "regulatory-guidance",
          "systematic-review"
        ]
      },
      "publicationStatus": {
        "type": "string",
        "enum": [
          "published",
          "preprint",
          "withdrawn",
          "superseded",
          "archived"
        ]
      },
      "proposedReliabilityTier": {
        "type": "string",
        "enum": [
          "tier-a",
          "tier-b",
          "tier-c",
          "tier-d"
        ]
      },
      "duplicateRisk": {
        "type": "string",
        "enum": [
          "low",
          "moderate",
          "high",
          "known-duplicate"
        ]
      },
      "duplicateOfSourceId": {
        "type": "string",
        "pattern": "^src_[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "reviewer": {
        "type": "string",
        "minLength": 1
      },
      "reviewedAt": {
        "type": "string",
        "format": "date-time"
      },
      "reviewStatus": {
        "type": "string",
        "enum": [
          "approved_for_registry",
          "blocked_pending_manual_review",
          "deprecated_candidate",
          "draft_candidate",
          "duplicate_of_existing",
          "needs_metadata",
          "rejected",
          "under_review"
        ]
      },
      "approvalNotes": {
        "type": "string"
      },
      "rejectionReasons": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "active": {
        "type": "boolean"
      },
      "relatedEntities": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entityType",
            "entitySlug"
          ],
          "properties": {
            "entityType": {
              "type": "string",
              "enum": [
                "herb",
                "compound"
              ]
            },
            "entitySlug": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "uniqueItems": true
      },
      "relatedTopicGaps": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "whyThisSourceMatters": {
        "type": "string",
        "minLength": 1
      },
      "blockerToPromotion": {
        "type": [
          "string",
          "null"
        ]
      },
      "dedupeCheck": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "matchedRegistrySourceIds",
          "matchedCandidateSourceIds",
          "checkedAgainst"
        ],
        "properties": {
          "matchedRegistrySourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "matchedCandidateSourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "checkedAgainst": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}

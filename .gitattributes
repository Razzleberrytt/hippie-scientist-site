# Normalize all text files to LF on checkout
* text=auto eol=lf

# Binary — never convert
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.pdf  binary
*.zip  binary
*.xlsx binary

# Compressed payloads. The repo's first .gz -- a runtime enrichment ledger --
# was committed while these were the only binary formats without a rule, so it
# inherited `* text=auto eol=lf`. Auto-detection spared it, but nothing should
# depend on that for a file whose bytes must survive verbatim.
*.gz   binary
*.tgz  binary
*.br   binary

# Explicit LF for source types
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.mdx  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.sh   text eol=lf

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    ".content-collections/generated/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    // Legacy modules carried over from the old src/ tree. They import helpers
    // deleted long ago (utils/calculateConfidence, utils/sanitizeData,
    // types/enrichmentDiscovery, data/interactionTags.seed) and cannot
    // compile. They were excluded before the move and stay excluded: nothing
    // imports them, and only report scripts name them as string paths.
    // Repairing or removing them is separate work.
    "lib/collectionEnrichment.ts",
    "lib/collectionQuality.ts",
    "lib/compound-data.ts",
    "lib/contentJourneyTracking.ts",
    "lib/data.ts",
    "lib/enrichmentDiscovery.ts",
    "lib/enrichmentRecommendations.ts",
    "lib/governedAnalytics.ts",
    "lib/governedCollectionDiscovery.ts",
    "lib/governedCollectionIntro.ts",
    "lib/governedFaq.ts",
    "lib/governedIntro.ts",
    "lib/governedQuickCompare.ts",
    "lib/governedRelatedQuestions.ts",
    "lib/governedResearch.ts",
    "lib/governedReviewFreshness.ts",
    "lib/growth.ts",
    "lib/herb-data.ts",
    "lib/interactionSeed.ts",
    "lib/researchEnrichment.ts",
    "types.ts",
    "node_modules",
    "scripts/**/*",
    "functions/**/*",
    "agent/**/*"
  ]
}
